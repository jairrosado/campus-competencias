<?xml version="1.0" encoding="utf-8"?>
<!--
    La app usa HTTPS en la nube y permite HTTP para el backend local del proyecto.
    En producción puedes restringir esta excepción si solo usas la URL de Render.
    10.0.2.2 es el host de desarrollo visto desde el emulador de Android.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
